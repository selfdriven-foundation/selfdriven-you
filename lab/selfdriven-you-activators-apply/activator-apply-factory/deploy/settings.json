{
    "infrastructure": {
        "aws": {
            "access": { "id": "prompt", "secret": "prompt" }
        }
    },
    "deploy": {
        "region":             "ap-southeast-2",
        "deployBucket":       "activator-apply-deploy",
        "applicationsBucket": "selfdriven-activator-applications",
        "applicationsPrefix": "applications/",
        "allowedOrigin":      "https://selfdriven.you",
        "lambdaFolder":       "../lambda",
        "lambdaZipName":      "activator-apply-lambda.zip",
        "functionName":       "activator-apply",
        "roleName":           "activator-apply-lambda-role",
        "handler":            "index.handler",
        "runtime":            "nodejs20.x",
        "timeout":            15,
        "memory":             256,
        "topicName":          "activator-apply-alerts",
        "notifyEmail":        "",
        "apiName":            "activator-apply-api",
        "apiStage":           "live",
        "webAclName":         "activator-apply-waf",
        "wafRateLimit":       300
    }
}
